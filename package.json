    "check": "npm run typecheck && npm test && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@langchain/cloudflare": "^1.1.0",
    "@langchain/core": "^1.3.5",
    "@langchain/textsplitters": "^1.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.158.0"
  }
}
