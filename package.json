{
  "name": "edge-ask",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal LangChain.js LCEL document Q&A demo on Cloudflare Workers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
