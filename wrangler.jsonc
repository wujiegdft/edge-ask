{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-ask",
  "account_id": "cbcb9be02f5c56f15463906657908eb9",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ask.wujie1123.shop",
      "zone_name": "wujie1123.shop",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "edge-ask-documents",
      "remote": true
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "cbcb9be02f5c56f15463906657908eb9"
  }
}
